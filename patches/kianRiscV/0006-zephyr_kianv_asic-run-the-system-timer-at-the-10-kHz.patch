From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lee Kage <magic-smoke@tinytapeout.com>
Date: Tue, 17 Nov 2026 12:01:12 +0000
Subject: zephyr_kianv_asic: run the system timer at the 10 kHz
 mtime rate

The KianV CLINT advances mtime at CPU_FREQ / UART_DIV[31:16], and the
boot loader programs that divider for 10 kHz (the Linux DTS uses the
same timebase-frequency = <10000>). The port assumed mtime ran at the
30 MHz CPU clock, so on silicon `kernel uptime` stayed at 0 ms and
`kernel sleep 1000` waited about 50 minutes.

Set timebase-frequency, the machine timer clock-frequency and
SYS_CLOCK_HW_CYCLES_PER_SEC to 10000. With 100 ticks/s from prj.conf
this gives 100 mtime cycles per tick.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 asic/os/zephyr_kianv_asic/README.md                   | 11 ++++++-----
 .../dts/riscv/kianv/kianv_rv32ima.dtsi                |  5 +++--
 .../soc/kianv/kianv_rv32ima/Kconfig.defconfig         |  4 +++-
 3 files changed, 12 insertions(+), 8 deletions(-)

diff --git a/asic/os/zephyr_kianv_asic/README.md b/asic/os/zephyr_kianv_asic/README.md
index 8e1f2f5..aa50f0d 100644
--- a/asic/os/zephyr_kianv_asic/README.md
+++ b/asic/os/zephyr_kianv_asic/README.md
@@ -5,7 +5,8 @@ Out-of-tree Zephyr port for the KianV RV32IMA ASIC SoC.
 ## Hardware Model
 
 - ISA: RV32IMA plus Zicsr/Zifencei
-- CPU/timer clock: 30 MHz
+- CPU clock: 30 MHz
+- Timer (`mtime`) clock: 10 kHz, set by the boot loader (`UART_DIV[31:16] = CPU_FREQ / 10000`)
 - UART baudrate: 115,200 baud
 - RAM/PSRAM: 8 MiB at `0x80000000`
 - SPI NOR flash window: `0x20000000`, reset/XIP bootloader at `0x20100000`
@@ -94,17 +95,17 @@ Zephyr's SoC and device-tree clock values are in
 `dts/riscv/kianv/kianv_rv32ima.dtsi`:
 
 ```dts
-timebase-frequency = <30000000>;
-clock-frequency = <30000000>;
+timebase-frequency = <10000>;     /* cpus: mtime rate */
+clock-frequency = <30000000>;     /* cpu0 and uart0 */
 current-speed = <115200>;
 ```
 
-The matching Zephyr kernel cycle rate is in
+The matching Zephyr kernel cycle rate (the `mtime` rate, not the CPU clock) is in
 `soc/kianv/kianv_rv32ima/Kconfig.defconfig`:
 
 ```kconfig
 config SYS_CLOCK_HW_CYCLES_PER_SEC
-	default 30000000
+	default 10000
 ```
 
 ## Zephyr Shell
diff --git a/asic/os/zephyr_kianv_asic/dts/riscv/kianv/kianv_rv32ima.dtsi b/asic/os/zephyr_kianv_asic/dts/riscv/kianv/kianv_rv32ima.dtsi
index 9c0999b..53cd283 100644
--- a/asic/os/zephyr_kianv_asic/dts/riscv/kianv/kianv_rv32ima.dtsi
+++ b/asic/os/zephyr_kianv_asic/dts/riscv/kianv/kianv_rv32ima.dtsi
@@ -11,7 +11,8 @@
 	cpus {
 		#address-cells = <1>;
 		#size-cells = <0>;
-		timebase-frequency = <30000000>;
+		/* mtime ticks at CPU_FREQ / UART_DIV[31:16]; the boot loader sets 10 kHz */
+		timebase-frequency = <10000>;
 
 		cpu0: cpu@0 {
 			device_type = "cpu";
@@ -86,7 +87,7 @@
 			reg = <0x1100bff8 0x8 0x11004000 0x8>;
 			reg-names = "mtime", "mtimecmp";
 			interrupts-extended = <&hlic0 7>;
-			clock-frequency = <30000000>;
+			clock-frequency = <10000>;
 			status = "okay";
 		};
 
diff --git a/asic/os/zephyr_kianv_asic/soc/kianv/kianv_rv32ima/Kconfig.defconfig b/asic/os/zephyr_kianv_asic/soc/kianv/kianv_rv32ima/Kconfig.defconfig
index e1959b1..b0b2331 100644
--- a/asic/os/zephyr_kianv_asic/soc/kianv/kianv_rv32ima/Kconfig.defconfig
+++ b/asic/os/zephyr_kianv_asic/soc/kianv/kianv_rv32ima/Kconfig.defconfig
@@ -3,8 +3,10 @@
 
 if SOC_KIANV_RV32IMA
 
+# mtime rate (10 kHz, set by the boot loader through UART_DIV[31:16]),
+# not the CPU clock.
 config SYS_CLOCK_HW_CYCLES_PER_SEC
-	default 30000000
+	default 10000
 
 config RISCV_SOC_INTERRUPT_INIT
 	default n
