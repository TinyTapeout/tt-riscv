From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lee Kage <magic-smoke@tinytapeout.com>
Date: Thu, 28 May 2026 14:50:08 +0000
Subject: ulinux_asic: target gf180mcu SoC variant (16 MiB QSPI
 PSRAM, GPIO peripheral)

Update the uLinux ASIC system image build to match the TinyTapeout
gf180mcu branch of KianV-RV32IMA-RISC-V-uLinux-SoC:

- DTS: bump PSRAM region from 8 MiB-4K to 16 MiB-4K, add the new
  gpio@10600000 peripheral (GPIO_UO_EN/UO_OUT/UI_IN, reg 0x0c),
  realign earlycon baud with kernel CMDLINE (115200n8).
- bootloader: lift SDRAM_END/MEMORY_SIZE to 16 MiB.
- Default build params: CPU_FREQ 31.5 MHz -> 16 MHz (chip clock per
  docs/info.md), BAUDRATE 3 Mbaud -> 115200 so the runtime UART divider
  written to 0x10000010 lands on a clean integer at the new clock,
  SPI_FREQ 10 MHz -> 8 MHz (must stay below CPU_FREQ/2).
- Rename workflow display name to reflect the gf180mcu target.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 asic/os/ulinux_asic_kianv_soc/Makefile                |  8 ++++----
 .../bldroot/board/kianv/rv32ima/kianv.dts             | 11 +++++++++--
 asic/os/ulinux_asic_kianv_soc/bootloader/Makefile     |  6 +++---
 asic/os/ulinux_asic_kianv_soc/bootloader/bootloader.c |  4 ++--
 4 files changed, 18 insertions(+), 11 deletions(-)

diff --git a/asic/os/ulinux_asic_kianv_soc/Makefile b/asic/os/ulinux_asic_kianv_soc/Makefile
index fa033fe..3c9be71 100644
--- a/asic/os/ulinux_asic_kianv_soc/Makefile
+++ b/asic/os/ulinux_asic_kianv_soc/Makefile
@@ -8,10 +8,10 @@ DIR := buildroot
 CC = gcc
 CFLAGS = -Wall -g
 
-# Default configurations for the bootloader
-CPU_FREQ ?= 31500000
-SPI_FREQ ?= 10000000
-BAUDRATE ?= 3000000
+# Default configurations for the bootloader (gf180mcu: 16 MHz core, 16 MiB QSPI PSRAM)
+CPU_FREQ ?= 16000000
+SPI_FREQ ?= 8000000
+BAUDRATE ?= 115200
 SOC_HAS_SPI ?= 0
 
 DTS_FILE ?= bldroot/board/kianv/rv32ima/kianv.dts
diff --git a/asic/os/ulinux_asic_kianv_soc/bldroot/board/kianv/rv32ima/kianv.dts b/asic/os/ulinux_asic_kianv_soc/bldroot/board/kianv/rv32ima/kianv.dts
index f8f01cc..8795b45 100644
--- a/asic/os/ulinux_asic_kianv_soc/bldroot/board/kianv/rv32ima/kianv.dts
+++ b/asic/os/ulinux_asic_kianv_soc/bldroot/board/kianv/rv32ima/kianv.dts
@@ -7,12 +7,12 @@
 	model = "riscv-minimal-nommu,qemu";
 
 	chosen {
-		bootargs = "earlycon=uart8250,mmio,0x10000000,3000000 console=ttyS0 debug";
+		bootargs = "earlycon=uart8250,mmio,0x10000000,115200 console=ttyS0 debug";
 	};
 
 	memory@80000000 {
 		device_type = "memory";
-		reg = <0x00 0x80000000 0x00 0x7ff000>;
+		reg = <0x00 0x80000000 0x00 0xfff000>;
 	};
 
 	cpus {
@@ -88,6 +88,13 @@
 			reg = <0x00 0x11000000 0x00 0x10000>;
 			compatible = "sifive,clint0\0riscv,clint0";
 		};
+
+		gpio@10600000 {
+			compatible = "kianv,gpio0";
+			reg = <0x00 0x10600000 0x00 0x0c>;
+			ngpios = <0x08>;
+			status = "okay";
+		};
 	};
 
 	spi@10500000 {
diff --git a/asic/os/ulinux_asic_kianv_soc/bootloader/Makefile b/asic/os/ulinux_asic_kianv_soc/bootloader/Makefile
index 8c73862..35adbf5 100644
--- a/asic/os/ulinux_asic_kianv_soc/bootloader/Makefile
+++ b/asic/os/ulinux_asic_kianv_soc/bootloader/Makefile
@@ -6,9 +6,9 @@ TOOLCHAIN_PATH ?= ../buildroot/output/host/bin
 
 TOOLCHAIN_PREFIX ?= $(TOOLCHAIN_PATH)/riscv32-buildroot-linux-uclibc
 
-CPU_FREQ ?= 31500000
-SPI_FREQ ?= 10000000
-BAUDRATE ?= 3000000
+CPU_FREQ ?= 16000000
+SPI_FREQ ?= 8000000
+BAUDRATE ?= 115200
 IMAGE_SIZE ?= $(shell wc -c < ../Image)
 SOC_HAS_SPI ?= 0
 
diff --git a/asic/os/ulinux_asic_kianv_soc/bootloader/bootloader.c b/asic/os/ulinux_asic_kianv_soc/bootloader/bootloader.c
index 137498e..62294c8 100644
--- a/asic/os/ulinux_asic_kianv_soc/bootloader/bootloader.c
+++ b/asic/os/ulinux_asic_kianv_soc/bootloader/bootloader.c
@@ -23,9 +23,9 @@
 #define DTB_TARGET (SPI_ADDR_BASE + (1024*1024 + 512*1024))
 #define KERNEL_IMAGE (SPI_ADDR_BASE + 1024 * 1024 * 2)
 #define MEMORY_BASE 0x80000000
-#define MEMORY_SIZE (1024*1024*7 - (1024*64))
+#define MEMORY_SIZE (1024*1024*16 - (1024*4))
 #define PROGRESS_INTERVAL (512*1024)
-#define SDRAM_END (0x80000000 + 1024 * 1024 * 8)
+#define SDRAM_END (0x80000000 + 1024 * 1024 * 16)
 #define SDRAM_START (0x80000000)
 #define SPI_ADDR_BASE 0x20000000
 
