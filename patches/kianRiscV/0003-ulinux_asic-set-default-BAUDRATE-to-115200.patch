From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lee Kage <magic-smoke@tinytapeout.com>
Date: Thu, 28 May 2026 15:00:12 +0000
Subject: ulinux_asic: set default BAUDRATE to 115200
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Target a standard 115200 console at the 30 MHz core clock instead of
3 Mbaud. At 30 MHz the integer UART divider (freq/BAUDRATE) is 260,
giving ~115384 baud (0.16% off — well inside tolerance) and matches
the kernel's compiled-in CONFIG_CMDLINE.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 asic/os/ulinux_asic_kianv_soc/Makefile                          | 2 +-
 .../ulinux_asic_kianv_soc/bldroot/board/kianv/rv32ima/kianv.dts | 2 +-
 asic/os/ulinux_asic_kianv_soc/bootloader/Makefile               | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/asic/os/ulinux_asic_kianv_soc/Makefile b/asic/os/ulinux_asic_kianv_soc/Makefile
index 93f8056..677fa1d 100644
--- a/asic/os/ulinux_asic_kianv_soc/Makefile
+++ b/asic/os/ulinux_asic_kianv_soc/Makefile
@@ -11,7 +11,7 @@ CFLAGS = -Wall -g
 # Default configurations for the bootloader (gf180mcu: 30 MHz core, 16 MiB QSPI PSRAM)
 CPU_FREQ ?= 30000000
 SPI_FREQ ?= 10000000
-BAUDRATE ?= 3000000
+BAUDRATE ?= 115200
 SOC_HAS_SPI ?= 0
 
 DTS_FILE ?= bldroot/board/kianv/rv32ima/kianv.dts
diff --git a/asic/os/ulinux_asic_kianv_soc/bldroot/board/kianv/rv32ima/kianv.dts b/asic/os/ulinux_asic_kianv_soc/bldroot/board/kianv/rv32ima/kianv.dts
index 937603b..8795b45 100644
--- a/asic/os/ulinux_asic_kianv_soc/bldroot/board/kianv/rv32ima/kianv.dts
+++ b/asic/os/ulinux_asic_kianv_soc/bldroot/board/kianv/rv32ima/kianv.dts
@@ -7,7 +7,7 @@
 	model = "riscv-minimal-nommu,qemu";
 
 	chosen {
-		bootargs = "earlycon=uart8250,mmio,0x10000000,3000000 console=ttyS0 debug";
+		bootargs = "earlycon=uart8250,mmio,0x10000000,115200 console=ttyS0 debug";
 	};
 
 	memory@80000000 {
diff --git a/asic/os/ulinux_asic_kianv_soc/bootloader/Makefile b/asic/os/ulinux_asic_kianv_soc/bootloader/Makefile
index 68135c6..205fa3a 100644
--- a/asic/os/ulinux_asic_kianv_soc/bootloader/Makefile
+++ b/asic/os/ulinux_asic_kianv_soc/bootloader/Makefile
@@ -8,7 +8,7 @@ TOOLCHAIN_PREFIX ?= $(TOOLCHAIN_PATH)/riscv32-buildroot-linux-uclibc
 
 CPU_FREQ ?= 30000000
 SPI_FREQ ?= 10000000
-BAUDRATE ?= 3000000
+BAUDRATE ?= 115200
 IMAGE_SIZE ?= $(shell wc -c < ../Image)
 SOC_HAS_SPI ?= 0
 
