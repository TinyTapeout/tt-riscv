From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lee Kage <magic-smoke@tinytapeout.com>
Date: Thu, 28 May 2026 15:49:01 +0000
Subject: ulinux_asic: pin the Buildroot SHA

Pin cnlohr/buildroot to 851edd247f5e2e8e10f943c52218bc54c657688f so
buildroot/output/ is deterministic across runs, then cache buildroot/dl
and buildroot/output keyed on the contents of every file that influences
the build (top-level Makefile, defconfig, board files, packages, rootfs
overlay, bootloader sources, hello_7seg sources). With restore-keys
fallback, subsequent rootfs-only iterations skip the ~15 min toolchain
rebuild and only redo kernel + initramfs.

First build on this key is still cold-cache (~25 min); future ones
should land around 5-8 min.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 asic/os/ulinux_asic_kianv_soc/Makefile | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/asic/os/ulinux_asic_kianv_soc/Makefile b/asic/os/ulinux_asic_kianv_soc/Makefile
index 677fa1d..6840965 100644
--- a/asic/os/ulinux_asic_kianv_soc/Makefile
+++ b/asic/os/ulinux_asic_kianv_soc/Makefile
@@ -3,6 +3,10 @@
 SHELL := /bin/bash
 REPO_URL := https://github.com/cnlohr/buildroot.git
 BRANCH := master
+# Pinned cnlohr/buildroot master HEAD as of 2026-05-28. Pinning lets CI
+# cache buildroot/output/ deterministically — change this SHA only with
+# intent and bust the workflow cache key accordingly.
+BUILDROOT_SHA := 851edd247f5e2e8e10f943c52218bc54c657688f
 DIR := buildroot
 
 CC = gcc
@@ -65,13 +69,17 @@ customize_buildroot: clone-buildroot
 
 clone-buildroot:
 	@if [ ! -d "$(DIR)" ]; then \
-	    echo "Cloning Buildroot into $(DIR)..."; \
-	    git clone -b $(BRANCH) $(REPO_URL) $(DIR) --depth=1 && \
+	    echo "Cloning Buildroot into $(DIR) and pinning to $(BUILDROOT_SHA)..."; \
+	    git clone $(REPO_URL) $(DIR) && \
 	    pushd $(DIR) && \
+	    git checkout $(BUILDROOT_SHA) && \
 	    popd; \
 	else \
-	    echo "Already cloned Buildroot into $(DIR)..."; \
+	    echo "Already cloned Buildroot into $(DIR), ensuring pin $(BUILDROOT_SHA)..."; \
 	    pushd $(DIR) && \
+	    if [ "$$(git rev-parse HEAD)" != "$(BUILDROOT_SHA)" ]; then \
+	        git fetch origin && git checkout $(BUILDROOT_SHA); \
+	    fi && \
 	    popd; \
 	fi
 
