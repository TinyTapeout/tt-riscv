+# --- Execute-in-place kernel -------------------------------------------------
+# Kernel .text/.rodata (and the built-in initramfs) stay in the SPI flash and
+# run from there; only .data/.bss go to PSRAM (copied by the kernel itself).
+# Flash layout: xip/bootloader.bin @0x100000, kianv.dtb @0x180000,
+# xip/Image @0x200000 (linked for 0x20200000: it cannot live anywhere else).
+XIP_DIR ?= xip/build
+XIP_LINUX_SRC ?= $(DIR)/output/build/linux-6.8-rc1
+XIP_TOOLCHAIN ?= $(abspath $(DIR))/output/host/bin/riscv32-buildroot-linux-uclibc-
+XIP_KMAKE = $(MAKE) -C $(XIP_DIR)/linux ARCH=riscv CROSS_COMPILE=$(XIP_TOOLCHAIN)
+
+xip:
+	@test -f $(XIP_LINUX_SRC)/.config || { echo "run 'make all' first"; exit 1; }
+	@grep -q NOMMU_XIP_KERNEL $(XIP_LINUX_SRC)/arch/riscv/Kconfig || \
+	  { echo "kernel tree lacks the XIP patch: run 'make customize_buildroot' and 'make -C $(DIR) linux-dirclean all'"; exit 1; }
+	mkdir -p $(XIP_DIR)
+	rsync -a --delete --exclude='*.o' --exclude='.*.cmd' --exclude='*.a' --exclude='/vmlinux*' \
+	  $(XIP_LINUX_SRC)/ $(XIP_DIR)/linux/
+	$(XIP_KMAKE) mrproper
+	cp $(XIP_LINUX_SRC)/.config $(XIP_DIR)/linux/.config
+	cd $(XIP_DIR)/linux && ARCH=riscv scripts/kconfig/merge_config.sh -m .config $(CURDIR)/xip/linux-xip.fragment
+	sed -i 's|^CONFIG_INITRAMFS_SOURCE=.*|CONFIG_INITRAMFS_SOURCE="$(abspath $(DIR))/output/images/rootfs.cpio"|' $(XIP_DIR)/linux/.config
+	$(XIP_KMAKE) olddefconfig
+	@grep -q '^CONFIG_NOMMU_XIP_KERNEL=y' $(XIP_DIR)/linux/.config
+	$(XIP_KMAKE) -j $(shell nproc) Image
+	cp $(XIP_DIR)/linux/arch/riscv/boot/Image xip/Image
+	rm -rf $(XIP_DIR)/bootloader && cp -r bootloader $(XIP_DIR)/bootloader
+	$(MAKE) -C $(XIP_DIR)/bootloader clean
+	$(MAKE) -C $(XIP_DIR)/bootloader TOOLCHAIN_PATH=$(abspath $(DIR))/output/host/bin \
+	  CPU_FREQ=$(CPU_FREQ) SPI_FREQ=$(SPI_FREQ) BAUDRATE=$(BAUDRATE) SOC_HAS_SPI=$(SOC_HAS_SPI) XIP_KERNEL=1
+	cp $(XIP_DIR)/bootloader/bootloader.bin xip/bootloader.bin
+	@echo "XIP kernel: xip/Image @0x200000, bootloader: xip/bootloader.bin @0x100000, dtb: kianv.dtb @0x180000"
+
+xip-sim: xip/Image
+	mkdir -p $(XIP_DIR)
+	$(XIP_TOOLCHAIN)gcc -march=rv32ima -mabi=ilp32 -nostdlib -Wl,-Ttext=0x20000000 -Wl,--no-relax \
+	  -o $(XIP_DIR)/qemu-flash-stub.elf xip/qemu-flash-stub.S
+	$(XIP_TOOLCHAIN)objcopy -O binary $(XIP_DIR)/qemu-flash-stub.elf $(XIP_DIR)/qemu-flash-stub.bin
+	python3 xip/mkflash.py $(XIP_DIR)/qemu-flash-stub.bin xip/Image $(XIP_DIR)/pflash0.bin
+	qemu-system-riscv32 -M virt -bios none -nographic -cpu rv32,mmu=off -m 16M \
+	  -drive if=pflash,unit=0,format=raw,file=$(XIP_DIR)/pflash0.bin
+
 clean-bootloader:
 	@echo "Cleaning bootloader..."
 	$(MAKE) -C bootloader clean
 
 clean: clean-bootloader
 	@echo "Cleaning Buildroot output directory..."
-	@rm -rf $(DIR)/output $(OUTPUT_DTB_FILE) $(OUTPUT_DTS_FILE)
+	@rm -rf $(DIR)/output $(OUTPUT_DTB_FILE) $(OUTPUT_DTS_FILE) $(XIP_DIR) xip/Image xip/bootloader.bin
 
