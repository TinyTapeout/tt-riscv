@@ -0,0 +1,298 @@
+diff --git a/arch/riscv/Kconfig b/arch/riscv/Kconfig
+index bffbd869a..69562f374 100644
+--- a/arch/riscv/Kconfig
++++ b/arch/riscv/Kconfig
+@@ -97,8 +97,8 @@ config RISCV
+ 	select HAVE_ARCH_AUDITSYSCALL
+ 	select HAVE_ARCH_HUGE_VMALLOC if HAVE_ARCH_HUGE_VMAP
+ 	select HAVE_ARCH_HUGE_VMAP if MMU && 64BIT && !XIP_KERNEL
+-	select HAVE_ARCH_JUMP_LABEL if !XIP_KERNEL
+-	select HAVE_ARCH_JUMP_LABEL_RELATIVE if !XIP_KERNEL
++	select HAVE_ARCH_JUMP_LABEL if !XIP_KERNEL && !NOMMU_XIP_KERNEL
++	select HAVE_ARCH_JUMP_LABEL_RELATIVE if !XIP_KERNEL && !NOMMU_XIP_KERNEL
+ 	select HAVE_ARCH_KASAN if MMU && 64BIT
+ 	select HAVE_ARCH_KASAN_VMALLOC if MMU && 64BIT
+ 	select HAVE_ARCH_KFENCE if MMU && 64BIT
+@@ -141,7 +141,7 @@ config RISCV
+ 	select HAVE_PERF_REGS
+ 	select HAVE_PERF_USER_STACK_DUMP
+ 	select HAVE_POSIX_CPU_TIMERS_TASK_WORK
+-	select HAVE_PREEMPT_DYNAMIC_KEY if !XIP_KERNEL
++	select HAVE_PREEMPT_DYNAMIC_KEY if !XIP_KERNEL && !NOMMU_XIP_KERNEL
+ 	select HAVE_REGS_AND_STACK_ACCESS_API
+ 	select HAVE_RETHOOK if !XIP_KERNEL
+ 	select HAVE_RSEQ
+@@ -161,7 +161,7 @@ config RISCV
+ 	select OF_IRQ
+ 	select PCI_DOMAINS_GENERIC if PCI
+ 	select PCI_MSI if PCI
+-	select RISCV_ALTERNATIVE if !XIP_KERNEL
++	select RISCV_ALTERNATIVE if !XIP_KERNEL && !NOMMU_XIP_KERNEL
+ 	select RISCV_INTC
+ 	select RISCV_TIMER if RISCV_SBI
+ 	select SIFIVE_PLIC
+@@ -962,6 +962,23 @@ config XIP_PHYS_ADDR
+ 	  be linked for and stored to.  This address is dependent on your
+ 	  own flash usage.
+ 
++config NOMMU_XIP_KERNEL
++	bool "Execute-In-Place kernel from memory-mapped flash (no MMU)"
++	depends on !MMU && RISCV_M_MODE && !SMP && !XIP_KERNEL
++	help
++	  Link the kernel so that its text and read-only data stay in
++	  memory-mapped (read-only) flash and are executed in place, while
++	  writable data and BSS live in RAM.  The kernel copies its data
++	  section from flash to RAM itself at entry, so the boot loader only
++	  has to jump to NOMMU_XIP_FLASH_ADDR with a0 = hartid, a1 = dtb.
++	  Saves the size of .text + .rodata (and the built-in initramfs) in RAM
++	  and the time to copy them.
++
++config NOMMU_XIP_FLASH_ADDR
++	hex "Flash address the XIP kernel is stored at and linked for"
++	depends on NOMMU_XIP_KERNEL
++	default "0x20200000"
++
+ config RISCV_ISA_FALLBACK
+ 	bool "Permit falling back to parsing riscv,isa for extension support by default"
+ 	default y
+diff --git a/arch/riscv/kernel/head.S b/arch/riscv/kernel/head.S
+index 4236a69c3..a1a1d50a5 100644
+--- a/arch/riscv/kernel/head.S
++++ b/arch/riscv/kernel/head.S
+@@ -223,6 +223,25 @@ SYM_CODE_START(_start_kernel)
+ 	csrr a0, CSR_MHARTID
+ #endif /* CONFIG_RISCV_M_MODE */
+ 
++#ifdef CONFIG_NOMMU_XIP_KERNEL
++	/*
++	 * Text and rodata execute in place from flash; copy the initial
++	 * contents of the writable sections from flash to RAM before anything
++	 * (hart lottery, boot_cpu_hartid, the stack) touches them.
++	 */
++	la t0, _data_loc
++	la t1, _sdata
++	la t2, _edata_copy
++	bgeu t1, t2, .Lxip_copy_done
++.Lxip_copy:
++	lw t3, 0(t0)
++	sw t3, 0(t1)
++	addi t0, t0, 4
++	addi t1, t1, 4
++	bltu t1, t2, .Lxip_copy
++.Lxip_copy_done:
++#endif
++
+ 	/* Load the global pointer */
+ 	load_global_pointer
+ 
+diff --git a/arch/riscv/kernel/setup.c b/arch/riscv/kernel/setup.c
+index 4f73c0ae4..069508a83 100644
+--- a/arch/riscv/kernel/setup.c
++++ b/arch/riscv/kernel/setup.c
+@@ -112,6 +112,18 @@ static int __init add_kernel_resources(void)
+ 	kimage_res.end = bss_res.end;
+ 	kimage_res.flags = IORESOURCE_SYSTEM_RAM | IORESOURCE_BUSY;
+ 
++	if (IS_ENABLED(CONFIG_NOMMU_XIP_KERNEL)) {
++		/* text and rodata stay in flash: only data and bss are RAM */
++		kimage_res.start = __pa_symbol(_sdata);
++		ret = add_resource(&iomem_resource, &kimage_res);
++		if (ret < 0)
++			return ret;
++		ret = add_resource(&kimage_res, &data_res);
++		if (ret < 0)
++			return ret;
++		return add_resource(&kimage_res, &bss_res);
++	}
++
+ 	ret = add_resource(&iomem_resource, &kimage_res);
+ 	if (ret < 0)
+ 		return ret;
+diff --git a/arch/riscv/kernel/vmlinux-nommu-xip.lds.S b/arch/riscv/kernel/vmlinux-nommu-xip.lds.S
+new file mode 100644
+index 000000000..8a019afb7
+--- /dev/null
++++ b/arch/riscv/kernel/vmlinux-nommu-xip.lds.S
+@@ -0,0 +1,156 @@
++/* SPDX-License-Identifier: GPL-2.0-only */
++/*
++ * Linker script for a no-MMU kernel executing in place from memory-mapped
++ * flash (CONFIG_NOMMU_XIP_KERNEL).
++ *
++ * Flash (VMA == flash address, linked at CONFIG_NOMMU_XIP_FLASH_ADDR):
++ *   head text, init text, text, rodata, initcall tables, built-in initramfs
++ * RAM (VMA == KERNEL_LINK_ADDR == PAGE_OFFSET, initial contents stored in
++ * flash right after rodata at _data_loc and copied by head.S):
++ *   data, ro_after_init, init data, BSS
++ *
++ * Image file offsets are LMAs: the image is written to flash at
++ * CONFIG_NOMMU_XIP_FLASH_ADDR and the boot loader jumps there.
++ */
++
++#include <asm/pgtable.h>
++#define LOAD_OFFSET CONFIG_NOMMU_XIP_FLASH_ADDR
++/* __ro_after_init data must be writable at boot: keep it out of rodata */
++#define RO_AFTER_INIT_DATA
++
++#include <asm/vmlinux.lds.h>
++#include <asm/page.h>
++#include <asm/cache.h>
++#include <asm/thread_info.h>
++
++OUTPUT_ARCH(riscv)
++ENTRY(_start)
++
++jiffies = jiffies_64;
++
++SECTIONS
++{
++	/* ---- flash, executed / read in place ---- */
++	. = LOAD_OFFSET;
++	_xiprom = .;
++	_start = .;
++	HEAD_TEXT_SECTION
++	INIT_TEXT_SECTION(16)
++	/* we have to discard exit text and such at runtime, not link time */
++	__exittext_begin = .;
++	.exit.text : AT(ADDR(.exit.text) - LOAD_OFFSET)
++	{
++		EXIT_TEXT
++	}
++	__exittext_end = .;
++
++	.text : AT(ADDR(.text) - LOAD_OFFSET) {
++		_text = .;
++		_stext = .;
++		TEXT_TEXT
++		SCHED_TEXT
++		LOCK_TEXT
++		KPROBES_TEXT
++		ENTRY_TEXT
++		IRQENTRY_TEXT
++		SOFTIRQENTRY_TEXT
++		_etext = .;
++	}
++	RO_DATA(L1_CACHE_BYTES)
++	.srodata : AT(ADDR(.srodata) - LOAD_OFFSET) {
++		*(.srodata*)
++	}
++	.init.rodata : AT(ADDR(.init.rodata) - LOAD_OFFSET) {
++		INIT_SETUP(16)
++		INIT_CALLS
++		CON_INITCALL
++		INIT_RAM_FS
++	}
++	. = ALIGN(16);
++	_exiprom = .;
++
++	/* ---- RAM; initial contents stored in flash at _data_loc ---- */
++	_data_loc = .;
++	. = KERNEL_LINK_ADDR;
++
++#undef LOAD_OFFSET
++#define LOAD_OFFSET (KERNEL_LINK_ADDR - (_data_loc - CONFIG_NOMMU_XIP_FLASH_ADDR))
++
++	_sdata = .;
++	_data = .;
++	RW_DATA(L1_CACHE_BYTES, PAGE_SIZE, THREAD_SIZE)
++	.sdata : AT(ADDR(.sdata) - LOAD_OFFSET) {
++		__global_pointer$ = . + 0x800;
++		*(.sdata*)
++	}
++	.got : AT(ADDR(.got) - LOAD_OFFSET) { *(.got*) }
++
++	. = ALIGN(8);
++	__start_ro_after_init = .;
++	.data.ro_after_init : AT(ADDR(.data.ro_after_init) - LOAD_OFFSET) {
++		*(.data..ro_after_init)
++	}
++	__end_ro_after_init = .;
++	_edata = .;
++
++	. = ALIGN(PAGE_SIZE);
++	__init_begin = .;
++	__init_data_begin = .;
++	.init.data : AT(ADDR(.init.data) - LOAD_OFFSET) {
++		INIT_DATA
++	}
++	.init.pi : AT(ADDR(.init.pi) - LOAD_OFFSET) {
++		KEEP(*(.init.pi*))
++	}
++	.init.bss : AT(ADDR(.init.bss) - LOAD_OFFSET) {
++		KEEP(*(.init.bss*))
++	}
++	.exit.data : AT(ADDR(.exit.data) - LOAD_OFFSET) {
++		EXIT_DATA
++	}
++	PERCPU_SECTION(L1_CACHE_BYTES)
++
++	. = ALIGN(8);
++	__soc_early_init_table : AT(ADDR(__soc_early_init_table) - LOAD_OFFSET) {
++		__soc_early_init_table_start = .;
++		KEEP(*(__soc_early_init_table))
++		__soc_early_init_table_end = .;
++	}
++	__soc_builtin_dtb_table : AT(ADDR(__soc_builtin_dtb_table) - LOAD_OFFSET) {
++		__soc_builtin_dtb_table_start = .;
++		KEEP(*(__soc_builtin_dtb_table))
++		__soc_builtin_dtb_table_end = .;
++	}
++	.rel.dyn : AT(ADDR(.rel.dyn) - LOAD_OFFSET) {
++		*(.rel.dyn*)
++	}
++	.rela.dyn : AT(ADDR(.rela.dyn) - LOAD_OFFSET) {
++		*(.rela .rela*)
++	}
++	.alternative : AT(ADDR(.alternative) - LOAD_OFFSET) {
++		__alt_start = .;
++		KEEP(*(.alternative))
++		__alt_end = .;
++	}
++	__init_data_end = .;
++
++	/* end of what head.S copies from flash; trailing marker gets its LMA */
++	. = ALIGN(16);
++	.data.endmark : AT(ADDR(.data.endmark) - LOAD_OFFSET) { LONG(0x58495045) }
++	_edata_copy = .;
++	_edata_loc = LOADADDR(.data.endmark) + SIZEOF(.data.endmark) + CONFIG_NOMMU_XIP_FLASH_ADDR;
++
++	. = ALIGN(PAGE_SIZE);
++	__init_end = .;
++
++	BSS_SECTION(PAGE_SIZE, PAGE_SIZE, 0)
++	. = ALIGN(PAGE_SIZE);
++	_end = .;
++
++	STABS_DEBUG
++	DWARF_DEBUG
++	ELF_DETAILS
++	.riscv.attributes 0 : { *(.riscv.attributes) }
++
++	DISCARDS
++}
