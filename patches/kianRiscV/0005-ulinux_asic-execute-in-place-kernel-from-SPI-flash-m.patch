new file mode 100644
index 0000000..503ac0c
--- /dev/null
+++ b/asic/os/ulinux_asic_kianv_soc/xip/linux-xip.fragment
@@ -0,0 +1,4 @@
+# Kernel text/rodata execute in place from the SPI flash, data/bss in PSRAM.
+# Needs patches/linux/0010-riscv-nommu-execute-in-place-kernel.patch.
+CONFIG_NOMMU_XIP_KERNEL=y
+CONFIG_NOMMU_XIP_FLASH_ADDR=0x20200000
diff --git a/asic/os/ulinux_asic_kianv_soc/xip/mkflash.py b/asic/os/ulinux_asic_kianv_soc/xip/mkflash.py
new file mode 100644
index 0000000..c79c5b1
--- /dev/null
+++ b/asic/os/ulinux_asic_kianv_soc/xip/mkflash.py
@@ -0,0 +1,7 @@
+"""Build a 32 MiB QEMU pflash image: stub at 0, XIP kernel Image at 0x200000."""
+import sys
+stub, img, out = sys.argv[1:4]
+f = bytearray(b'\xff' * (32 << 20))
+s = open(stub, 'rb').read(); f[0:len(s)] = s
+i = open(img, 'rb').read(); f[0x200000:0x200000 + len(i)] = i
+open(out, 'wb').write(f)
diff --git a/asic/os/ulinux_asic_kianv_soc/xip/qemu-flash-stub.S b/asic/os/ulinux_asic_kianv_soc/xip/qemu-flash-stub.S
new file mode 100644
index 0000000..5bde88b
--- /dev/null
+++ b/asic/os/ulinux_asic_kianv_soc/xip/qemu-flash-stub.S
@@ -0,0 +1,7 @@
+/* QEMU virt boots from pflash0 (0x20000000) when one is given: jump to the XIP kernel like the bootloader does (a0 = hartid, a1 = QEMU dtb). */
+	.section .text
+	.globl _start
+_start:
+	/* a0 = hartid, a1 = fdt (from QEMU reset vector) */
+	li t0, 0x20200000
+	jr t0
